---
/**
 * The site's base layout — the house shell from the package, fed this
 * site's OWN injected config (TODO.public track 02): the package went
 * machinery-only at 0.2.0, so the brand, the nav model, and the footer
 * content come from src/data/ and thread down through the shell's
 * typed contract. One injection point: every page mounts this layout.
 * The site mounts no AI surfaces, so there is no services registry and
 * no assistant flag — with no origin configured, enabling one would be
 * a build error.
 */
import Shell from '@oimlsmart/site-shell/chrome/astro/Base.astro'
import { BRAND } from '../data/brand'
import { NAV_MODEL } from '../data/nav-config'
import { FOOTER } from '../data/footer'
import '../styles/app.css'

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
---

<Shell title={title} description={description} brand={BRAND} nav={NAV_MODEL} footer={FOOTER}>
  <slot />
</Shell>

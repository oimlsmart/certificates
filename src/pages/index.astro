---
import Site from '../layouts/Site.astro'
import { MinisiteNav, PageHero } from '@oimlsmart/site-shell/chrome/astro'
import { MINISITE_SECTIONS } from '../data/nav-config'
import { recs, manifest, digitalizedFor } from '../lib/corpus.ts'

const families = recs()
const totalScraped = manifest().length
const totalDigitalized = families.reduce((n, r) => n + digitalizedFor(r).length, 0)
---

<Site title="About" description="The real-world OIML-CS certificate corpus, browsable.">
  <MinisiteNav sections={MINISITE_SECTIONS} base="/certificates" />
  <main class="max-w-4xl mx-auto px-6 py-14">
    <PageHero
      eyebrow="OIML SMART · The real-world corpus"
      title="OIML-CS Certificates"
      lede="Every certificate issued under the OIML Certification System, scraped from the public register and digitalized: browsable, searchable, and citable back to the source PDF."
    />
    <section class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">{totalScraped.toLocaleString()} certificates scraped</h2>
        <p class="text-sm text-ink-soft leading-relaxed">The full public register across {families.length} Recommendation families, downloaded from oiml.org with its manifest of numbers, applicants, issuers, years, and statuses.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">{totalDigitalized.toLocaleString()} digitalized in full text</h2>
        <p class="text-sm text-ink-soft leading-relaxed">A stratified sample OCR'd into structured content, with the per-certificate fields and the full text. The rest links straight to the source PDF.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">22 schemas synthesized</h2>
        <p class="text-sm text-ink-soft leading-relaxed">One per Recommendation family: the field vocabulary of its certificates, learned from the corpus. The basis of machine-readable certificate work.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">Provenance to the PDF</h2>
        <p class="text-sm text-ink-soft leading-relaxed">Every digitalized certificate names its source PDF and its extraction method. The raw scrape is one repository away, always.</p>
      </div>
    </section>
    <p class="mt-10 text-sm"><a href="/certificates/browse" class="text-accent font-medium">Browse the Recommendation families →</a></p>
  </main>
</Site>

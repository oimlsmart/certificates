---
import { Base, MinisiteNav } from '@oimlsmart/site-shell'
import '../../styles/app.css'
import { recs, schemaFor, statsFor } from '../../lib/corpus.ts'

export function getStaticPaths() {
  return recs().filter(r => !!schemaFor(r)).map(rec => ({ params: { rec } }))
}

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Browse', href: '/browse' },
  { label: 'Schemas', href: '/schemas' },
  { label: 'Story', href: '/story' },
]

type Prop = Record<string, unknown> & { $ref?: string; type?: string | string[]; const?: unknown; enum?: unknown[]; items?: Prop }
type Definition = { required?: string[]; properties?: Record<string, Prop>; description?: string }

const { rec } = Astro.params
const schema = schemaFor(rec)! as {
  title?: string
  required?: string[]
  properties?: Record<string, Prop>
  definitions?: Record<string, Definition>
}

function shapeOf(prop: Prop): string {
  if (typeof prop.$ref === 'string') {
    const name = prop.$ref.split('/').pop()!
    return prop.$ref.startsWith('_core') ? `core · ${name}` : name
  }
  if (typeof prop.const !== 'undefined') return `const ${JSON.stringify(prop.const)}`
  if (Array.isArray(prop.enum)) return `enum of ${prop.enum.length}`
  if (prop.type === 'array' && prop.items) return `array of ${shapeOf(prop.items)}`
  if (Array.isArray(prop.type)) return prop.type.join(' or ')
  return typeof prop.type === 'string' ? prop.type : 'object'
}

const requiredTop = new Set(schema.required ?? [])
const topRows = Object.entries(schema.properties ?? {}).map(([name, p]) => ({
  name, shape: shapeOf(p), req: requiredTop.has(name),
}))

const defs = Object.entries(schema.definitions ?? {}).map(([defName, def]) => ({
  defName,
  rows: Object.entries(def.properties ?? {}).map(([name, p]) => ({
    name, shape: shapeOf(p), req: (def.required ?? []).includes(name),
  })),
}))

const stats = statsFor(rec)
const statRows = Object.entries(stats?.type_level_characteristics ?? {}).map(([name, c]) => {
  const samples = (c.top_values ?? [])
    .map(v => (typeof v.value === 'string' || typeof v.value === 'number') ? String(v.value) : (v.range ?? null))
    .filter((s): s is string => !!s && !s.startsWith('{'))
    .slice(0, 3)
    .join(', ')
  return { name, fill: Math.round((c.fill_rate ?? 0) * 100), count: c.present_count ?? 0, samples }
}).sort((a, b) => b.fill - a.fill)
---

<Base title={`The ${rec} schema`} description={`The certificate schema of ${rec}, synthesized from the corpus.`}>
  <MinisiteNav sections={NAV} base="/certificates" />
  <main class="max-w-4xl mx-auto px-6 py-14">
    <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3"><a href="/certificates/schemas" class="text-accent">← Schemas</a> · {rec}</p>
    <h1 class="font-serif text-3xl font-semibold text-ink mb-2">The {rec} schema</h1>
    <p class="text-ink-soft mb-8">{schema.title ?? `The ${rec} certificate schema`}. The certificate structure lists the top-level fields of the document model. The definitions expand the family's own vocabulary. Where the corpus carries fill statistics, the observed fields table shows how often each characteristic actually appears.</p>

    <h2 class="font-serif text-xl font-semibold text-ink mt-10 mb-3">Certificate structure</h2>
    <p class="text-ink-soft text-sm mb-4">Every {rec} certificate is one object with these top-level fields. A "core" shape is shared across all Recommendation families; the rest are defined by this family's own definitions below.</p>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left border-b border-rule">
          <th class="py-2 pr-4 font-semibold text-ink">Field</th>
          <th class="py-2 pr-4 font-semibold text-ink">Shape</th>
          <th class="py-2 font-semibold text-ink">Required</th>
        </tr>
      </thead>
      <tbody>
        {topRows.map(r => (
          <tr class="border-b border-rule/60">
            <td class="py-1.5 pr-4 font-mono text-xs">{r.name}</td>
            <td class="py-1.5 pr-4 text-ink-soft">{r.shape}</td>
            <td class="py-1.5 text-ink-soft">{r.req ? 'yes' : 'no'}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {statRows.length > 0 && (
      <>
        <h2 class="font-serif text-xl font-semibold text-ink mt-12 mb-3">Observed fields</h2>
        <p class="text-ink-soft text-sm mb-4">From {stats?.sample_size ?? 'the'} digitalized {rec} certificates: how often each type-level characteristic appears (fill rate), in how many certificates, and the most common values observed.</p>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left border-b border-rule">
              <th class="py-2 pr-4 font-semibold text-ink">Field</th>
              <th class="py-2 pr-4 font-semibold text-ink text-right">Fill rate</th>
              <th class="py-2 pr-4 font-semibold text-ink text-right">Present in</th>
              <th class="py-2 font-semibold text-ink">Common values</th>
            </tr>
          </thead>
          <tbody>
            {statRows.map(r => (
              <tr class="border-b border-rule/60">
                <td class="py-1.5 pr-4 font-mono text-xs">{r.name}</td>
                <td class="py-1.5 pr-4 text-right text-ink-soft">{r.fill}%</td>
                <td class="py-1.5 pr-4 text-right text-ink-soft">{r.count}</td>
                <td class="py-1.5 text-ink-soft">{r.samples}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}

    <h2 class="font-serif text-xl font-semibold text-ink mt-12 mb-3">Definitions</h2>
    <p class="text-ink-soft text-sm mb-4">The shapes named by the certificate structure above, expanded to their fields.</p>
    {defs.map(d => (
      <div class="mb-8">
        <h3 class="font-mono text-sm font-semibold text-ink mt-6 mb-2">{d.defName}</h3>
        <table class="w-full text-sm">
          <tbody>
            {d.rows.map(r => (
              <tr class="border-b border-rule/60">
                <td class="py-1.5 pr-4 font-mono text-xs w-1/3">{r.name}</td>
                <td class="py-1.5 pr-4 text-ink-soft">{r.shape}</td>
                <td class="py-1.5 text-ink-soft text-right">{r.req ? 'required' : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </main>
</Base>

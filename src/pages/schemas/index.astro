---
import { Base, MinisiteNav } from '@oimlsmart/site-shell'
import '../../styles/app.css'
import { recs, schemaFor } from '../../lib/corpus.ts'

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Browse', href: '/browse' },
  { label: 'Schemas', href: '/schemas' },
  { label: 'Story', href: '/story' },
]
const families = recs().map(rec => ({ rec, has: !!schemaFor(rec) })).filter(f => f.has)
---

<Base title="The schemas" description="The per-Recommendation certificate schemas synthesized from the corpus.">
  <MinisiteNav sections={NAV} base="/certificates" />
  <main class="max-w-4xl mx-auto px-6 py-14">
    <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3">OIML-CS Certificates · Schemas</p>
    <h1 class="font-serif text-3xl font-semibold text-ink mb-6">The per-Recommendation schemas</h1>
    <p class="text-ink-soft mb-8">Each family's field vocabulary, learned from its certificates: which fields exist, how often they appear, and their observed value shapes. The basis of machine-readable certificate work.</p>
    <ul class="space-y-2">
      {families.map(f => (
        <li><a class="text-accent font-mono" href={`/certificates/schemas/${f.rec}/`}>{f.rec}.yaml</a></li>
      ))}
    </ul>
  </main>
</Base>
